{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "SeasonPal.Api",
    "Audience": "SeasonPal.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RateLimiting": {
    "AuthPermitLimit": 10
  }
}
