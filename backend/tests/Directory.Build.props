<Project>

  <!-- Walker stops at the nearest Directory.Build.props: re-import the backend root by hand. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Test projects live under backend/tests/; IsPackable is off here so csprojs stay minimal. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
