# Copy this file to .env and fill in the local credentials before starting
# Docker Compose. .env is git-ignored; never commit real credentials.
#
# Keep POSTGRES_DB, POSTGRES_USER, and POSTGRES_PASSWORD in sync with the
# backend's Development connection string.
#
# Postgres applies these values only when its data volume is first created.
# pgAdmin applies its credentials only when its volume is first created.

POSTGRES_DB=seasonpal
POSTGRES_USER=seasonpal
POSTGRES_PASSWORD=

PGADMIN_DEFAULT_EMAIL=dev@seasonpal.app
PGADMIN_DEFAULT_PASSWORD=
